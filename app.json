{
  "expo": {
    "name": "Yo-Vazaluza",
    "slug": "yo-vazaluza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A4A4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dalipi.yovazaluza"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A4A4A"
      },
      "package": "com.dalipi.yovazaluza",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "yo-vazaluza-app"
      }
    }
  }
}
